{
	"name": "slightly-better-gh-search",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:supabase": "deno test --allow-net --allow-env --env-file=supabase/.env.test --config=supabase/functions/deno.json supabase/functions/**/*_test.ts",
		"test:supabase:serve": "supabase functions serve --env-file supabase/.env.test",
		"test:supabase:watch": "deno test --allow-net --allow-env --env-file=supabase/.env.test --config=supabase/functions/deno.json --watch supabase/functions/**/*_test.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@iconify/json": "^2.2.470",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.2.4",
		"@types/node": "^25.6.2",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"supabase": "^2.98.2",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.2",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.0.11"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"supabase"
		],
		"overrides": {
			"cookie": "^0.7.0"
		}
	},
	"dependencies": {
		"@supabase/ssr": "^0.10.3",
		"@supabase/supabase-js": "^2.105.3",
		"@vercel/analytics": "^2.0.1"
	}
}